# Resend API (Contact Form & Admin Notifications)
# https://resend.com/api-keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# 네이버 클라우드 플랫폼 지도 API (NCP Maps)
# https://www.ncloud.com/product/applicationService/maps 에서 발급
NEXT_PUBLIC_NCP_CLIENT_ID=your_ncp_client_id_here

# 사이트 URL (프로덕션)
NEXT_PUBLIC_SITE_URL=https://kwanhoonarte.com

# ============================================
# Supabase (Admin CRM)
# https://supabase.com/dashboard 에서 프로젝트 생성 후 발급
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Anthropic API (명함 스캔 기능)
# https://console.anthropic.com/settings/keys 에서 발급
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SMS (Optional - 추후 설정)
# ============================================
# Twilio
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# 또는 NHN Cloud SMS
# NHN_APP_KEY=your_nhn_app_key
# NHN_SECRET_KEY=your_nhn_secret_key
# NHN_SENDER_NUMBER=01012345678
